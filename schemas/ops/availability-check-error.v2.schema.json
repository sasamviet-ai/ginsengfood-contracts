{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ops/availability-check-error.v2.schema.json",
  "title": "Availability Check Error Envelope v2",
  "description": "Strict public-safe external error envelope for Availability v2. Every error fails closed and forbids reuse of an earlier SELLABLE result.",
  "$comment": "OWNER-DIRECTIVE-2026-09-03-EXT-OD-01-07 / EXT-OD-03,04,07. Retry is allowed only for transport timeout or HTTP 408/429/502/503/504, must honor Retry-After, is limited to one retry, and must stay within a five-second total budget.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "v2"
    },
    "correlation": {
      "$ref": "../common/correlation.schema.json"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "WAREHOUSE_NOT_FOUND",
            "REQUEST_TIMEOUT",
            "UNSUPPORTED_MEDIA_TYPE",
            "VALIDATION_FAILED",
            "RATE_LIMITED",
            "INTERNAL_ERROR",
            "UPSTREAM_UNAVAILABLE",
            "UPSTREAM_TIMEOUT"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Safe message without stack traces, credentials, subject IDs, limiter partition keys, or internal topology."
        },
        "http_status": {
          "type": "integer",
          "enum": [
            400,
            401,
            403,
            404,
            408,
            415,
            422,
            429,
            500,
            502,
            503,
            504
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "http_status",
        "retryable"
      ],
      "oneOf": [
        {
          "properties": {
            "code": { "const": "INVALID_REQUEST" },
            "http_status": { "const": 400 },
            "retryable": { "const": false }
          }
        },
        {
          "properties": {
            "code": { "const": "UNAUTHORIZED" },
            "http_status": { "const": 401 },
            "retryable": { "const": false }
          }
        },
        {
          "properties": {
            "code": { "const": "FORBIDDEN" },
            "http_status": { "const": 403 },
            "retryable": { "const": false }
          }
        },
        {
          "properties": {
            "code": { "const": "WAREHOUSE_NOT_FOUND" },
            "http_status": { "const": 404 },
            "retryable": { "const": false }
          }
        },
        {
          "properties": {
            "code": { "const": "REQUEST_TIMEOUT" },
            "http_status": { "const": 408 },
            "retryable": { "const": true }
          }
        },
        {
          "properties": {
            "code": { "const": "UNSUPPORTED_MEDIA_TYPE" },
            "http_status": { "const": 415 },
            "retryable": { "const": false }
          }
        },
        {
          "properties": {
            "code": { "const": "VALIDATION_FAILED" },
            "http_status": { "const": 422 },
            "retryable": { "const": false }
          }
        },
        {
          "properties": {
            "code": { "const": "RATE_LIMITED" },
            "http_status": { "const": 429 },
            "retryable": { "const": true }
          }
        },
        {
          "properties": {
            "code": { "const": "INTERNAL_ERROR" },
            "http_status": { "const": 500 },
            "retryable": { "const": false }
          }
        },
        {
          "properties": {
            "code": { "const": "UPSTREAM_UNAVAILABLE" },
            "http_status": { "enum": [502, 503] },
            "retryable": { "const": true }
          }
        },
        {
          "properties": {
            "code": { "const": "UPSTREAM_TIMEOUT" },
            "http_status": { "const": 504 },
            "retryable": { "const": true }
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_mode": {
          "type": "string",
          "const": "UNKNOWN_BLOCK"
        },
        "cached_sellable_reused": {
          "type": "boolean",
          "const": false
        },
        "rate_limit_policy": {
          "type": "string",
          "const": "ExternalAvailabilityCheck"
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "failure_mode",
        "cached_sellable_reused"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "correlation",
    "error",
    "meta"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "properties": {
              "code": { "const": "RATE_LIMITED" }
            },
            "required": ["code"]
          }
        },
        "required": ["error"]
      },
      "then": {
        "properties": {
          "meta": {
            "required": [
              "failure_mode",
              "cached_sellable_reused",
              "rate_limit_policy",
              "retry_after_seconds"
            ]
          }
        }
      }
    }
  ]
}
