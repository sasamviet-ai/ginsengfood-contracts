{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ops/availability-check-success.v2.schema.json",
  "title": "Availability Check Success Envelope v2",
  "description": "Strict external success envelope for POST /v2/availability/check. Provider cache is disabled and the result may be reused by a consumer for at most five seconds.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "v2"
    },
    "correlation": {
      "$ref": "../common/correlation.schema.json"
    },
    "data": {
      "$ref": "availability-check-result.v2.schema.json"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_cache_seconds": {
          "type": "integer",
          "const": 0
        },
        "consumer_max_reuse_seconds": {
          "type": "integer",
          "const": 5
        },
        "rate_limit_policy": {
          "type": "string",
          "const": "ExternalAvailabilityCheck"
        },
        "server_timeout_seconds": {
          "type": "integer",
          "const": 2
        },
        "max_retry": {
          "type": "integer",
          "const": 1
        },
        "total_retry_budget_seconds": {
          "type": "integer",
          "const": 5
        }
      },
      "required": [
        "provider_cache_seconds",
        "consumer_max_reuse_seconds",
        "rate_limit_policy",
        "server_timeout_seconds",
        "max_retry",
        "total_retry_budget_seconds"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "correlation",
    "data",
    "meta"
  ]
}
