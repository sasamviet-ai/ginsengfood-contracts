{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ops/v1/sale-lock.schema.json",
  "title": "Sale Lock Response",
  "description": "Sale Lock v1 response. Sale Lock / Stop Sale wins over Product Activation, channels, quote, order, and field actions.",
  "$comment": "Sources: PACK-01 Sale Lock / Stop Sale; OD-RCL-03; OD-M13-RCL-SCOPE-003 (2026-08-13).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sale_lock_id": { "type": "string", "minLength": 1, "description": "Sale lock identifier." },
    "scope_type": { "type": "string", "enum": ["SKU", "BATCH", "LOT", "TRACE_CHAIN"], "description": "External v1 scope blocked by sale lock." },
    "scope_id": { "type": "string", "minLength": 1, "description": "Identifier of locked scope." },
    "status": { "type": "string", "enum": ["ACTIVE", "RELEASE_REQUESTED", "RELEASED", "REVIEW_REQUIRED", "BLOCKED"], "description": "Sale Lock status." },
    "active": { "type": "boolean", "description": "True while sale lock blocks selling flows." },
    "reason": { "type": "string", "minLength": 1, "description": "Reason for stop-sale/sale-lock." },
    "recall_case_id": { "type": "string", "minLength": 1, "description": "Linked Recall Case." },
    "effective_from": { "type": "string", "format": "date-time", "description": "Effective start time." },
    "effective_to": { "type": "string", "format": "date-time", "description": "Effective end time when released." },
    "owner_approval_ref": { "$ref": "../common/owner-decision-ref.schema.json" },
    "evidence_refs": { "type": "array", "items": { "$ref": "../common/evidence-ref.schema.json" } },
    "audit_refs": { "type": "array", "items": { "$ref": "../common/audit.schema.json" } }
  },
  "required": ["sale_lock_id", "scope_type", "scope_id", "status", "active", "reason", "recall_case_id", "effective_from"],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ACTIVE" } }, "required": ["status"] },
      "then": { "properties": { "active": { "const": true } } }
    },
    {
      "if": { "properties": { "status": { "const": "RELEASED" } }, "required": ["status"] },
      "then": { "properties": { "active": { "const": false } }, "required": ["effective_to"] }
    }
  ]
}
