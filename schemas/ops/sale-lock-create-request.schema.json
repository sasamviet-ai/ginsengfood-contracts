{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/ops/v1/sale-lock-create-request.schema.json",
  "title": "Create Sale Lock Request",
  "description": "External v1 high-risk request for activating a Sale Lock. Response-owned identifiers/status fields are not accepted.",
  "$comment": "Sources: PACK-01 Sale Lock / Stop Sale; OD-RCL-03; OD-M13-RCL-SCOPE-003.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recall_case_id": { "type": "string", "format": "uuid" },
    "scope_type": { "type": "string", "enum": ["SKU", "BATCH", "LOT", "TRACE_CHAIN"] },
    "scope_id": {
      "type": "string",
      "format": "uuid",
      "description": "Canonical operational object UUID. For TRACE_CHAIN, this MUST equal recall_case_id and identifies the complete versioned historical impact union of that Recall Case."
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "owner_approval_ref": { "$ref": "../common/owner-decision-ref.schema.json" },
    "evidence_refs": { "type": "array", "items": { "$ref": "../common/evidence-ref.schema.json" } }
  },
  "required": ["recall_case_id", "scope_type", "scope_id", "reason"],
  "examples": [
    { "recall_case_id": "10000000-0000-4000-8000-000000000001", "scope_type": "SKU", "scope_id": "20000000-0000-4000-8000-000000000001", "reason": "Stop sale while Recall is active." },
    { "recall_case_id": "10000000-0000-4000-8000-000000000002", "scope_type": "BATCH", "scope_id": "30000000-0000-4000-8000-000000000001", "reason": "Affected batch containment." },
    { "recall_case_id": "10000000-0000-4000-8000-000000000003", "scope_type": "LOT", "scope_id": "40000000-0000-4000-8000-000000000001", "reason": "Affected lot containment." },
    { "recall_case_id": "10000000-0000-4000-8000-000000000004", "scope_type": "TRACE_CHAIN", "scope_id": "10000000-0000-4000-8000-000000000004", "reason": "Contain the complete historical impact union for this Recall Case." }
  ]
}
