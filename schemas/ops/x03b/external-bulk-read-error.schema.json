{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-bulk-read-error.schema.json",
  "title": "External bulk-read safe error",
  "description": "Safe machine-readable error surface for external bulk-read and cursor failures.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "enum": ["INVALID_REQUEST", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "CURSOR_INVALID", "CHANGE_FEED_GAP", "CURSOR_EXPIRED", "VALIDATION_FAILED", "RATE_LIMITED", "REQUEST_TIMEOUT", "BAD_GATEWAY", "SERVICE_UNAVAILABLE", "GATEWAY_TIMEOUT", "INTERNAL_ERROR"]
    },
    "message": { "type": "string", "minLength": 1 },
    "httpStatus": { "type": "integer", "minimum": 400, "maximum": 599 },
    "correlationId": { "type": "string", "minLength": 1 },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["reason"]
      }
    }
  },
  "required": ["code", "message", "httpStatus", "correlationId"],
  "oneOf": [
    { "properties": { "code": { "const": "INVALID_REQUEST" }, "httpStatus": { "const": 400 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "UNAUTHORIZED" }, "httpStatus": { "const": 401 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "FORBIDDEN" }, "httpStatus": { "const": 403 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "NOT_FOUND" }, "httpStatus": { "const": 404 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "REQUEST_TIMEOUT" }, "httpStatus": { "const": 408 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "CURSOR_INVALID" }, "httpStatus": { "const": 400 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "CHANGE_FEED_GAP" }, "httpStatus": { "const": 409 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "CURSOR_EXPIRED" }, "httpStatus": { "const": 410 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "VALIDATION_FAILED" }, "httpStatus": { "const": 422 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "RATE_LIMITED" }, "httpStatus": { "const": 429 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "INTERNAL_ERROR" }, "httpStatus": { "const": 500 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "BAD_GATEWAY" }, "httpStatus": { "const": 502 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "SERVICE_UNAVAILABLE" }, "httpStatus": { "const": 503 } }, "required": ["code", "httpStatus"] },
    { "properties": { "code": { "const": "GATEWAY_TIMEOUT" }, "httpStatus": { "const": 504 } }, "required": ["code", "httpStatus"] }
  ]
}
