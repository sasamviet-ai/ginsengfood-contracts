{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-public-sku.schema.json",
  "title": "Protected external public SKU projection",
  "description": "Public-safe but authenticated SKU whitelist without recipe, formula, BOM, source, evidence, supplier, cost, or QC fields.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sku_id": { "type": "string", "format": "uuid" },
    "sku_code": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "format": "uuid" },
    "public_name": { "type": "string", "minLength": 1 },
    "dietary_type": { "type": "string", "enum": ["VEGAN", "SAVORY"] },
    "product_group": { "type": "string", "minLength": 1 },
    "lifecycle_status": { "type": "string", "enum": ["DRAFT", "PENDING_CONFIG", "PENDING_EVIDENCE", "READY", "ACTIVE", "INACTIVE", "BLOCKED"] }
  },
  "required": ["sku_id", "sku_code", "product_id", "public_name", "lifecycle_status"]
}
