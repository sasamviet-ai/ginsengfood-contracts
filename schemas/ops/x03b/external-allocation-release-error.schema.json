{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-allocation-release-error.schema.json",
  "title": "External allocation release error envelopes",
  "description": "Error envelopes for POST /v1/inventory/allocations/release. The envelope shape is identical to the reserve and bulk-read ones so a consumer parses all of them with the same reader; only the code vocabulary differs. Closed enum per operation: ALLOCATION_NOT_HELD exists only here, and INSUFFICIENT_STOCK (a shortage) can never come from a release.",
  "$comment": "ALLOCATION_NOT_HELD (409) means the source no longer has any hold of this service principal that can be released: it was already released, or its hold expired and the expiry worker has not yet swept it. It is a logical success for a cancelling consumer: nothing is held, nothing was changed, and a retry will not change the answer. ALLOCATION_CONFLICT (409) on this route means the warehouse already CONFIRMED or ISSUED stock of the source and nothing was released (contact the warehouse), or the allocation changed while the release was being processed; the two share one code and differ only in message text, so a consumer that gets it reads GET /v1/inventory/allocations?sourceObjectId= once to learn the current state instead of looping. A release whose first attempt with the same X-Idempotency-Key is still running is 429 with Retry-After: 1, not 409, and so is temporary contention that outlasts the provider's own retries (same code RATE_LIMITED, a different message, retry with the same key and body). A source held by another principal and an unknown source are both 404, with the same message. The provider never forwards internal reason text: the message of each code is a fixed string. details exist on a 422 VALIDATION_FAILED only, never on 409 ALLOCATION_CONFLICT, 409 ALLOCATION_NOT_HELD or any other code, and carry either the one stable token of x-detail-reasons or free text that is not contractual (read details[].field, never the wording).",
  "x-detail-reasons": {
    "description": "Closed table of the stable details[].reason tokens of this operation. A stable token is a contract value and never changes wording. Every other reason on a 422 is free text produced by input validation (English for body fields, possibly Vietnamese for X-Idempotency-Key format problems) and is not contractual: handle it by field and HTTP status. No other error code carries details. A null field means the item has no field.",
    "stable": [
      {
        "httpStatus": 422,
        "code": "VALIDATION_FAILED",
        "field": "X-Idempotency-Key",
        "reason": "IDEMPOTENCY_KEY_REUSED"
      }
    ],
    "other_reasons_are_free_text": true,
    "free_text_fields": [
      "X-Idempotency-Key",
      "source_object_type",
      "source_object_id"
    ]
  },
  "$defs": {
    "Detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "The request body field or header that the reason is about. Omitted when the reason is not about one field."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "A stable token from x-detail-reasons.stable (IDEMPOTENCY_KEY_REUSED), otherwise free text that is not contractual: key on field, never on the text."
        }
      },
      "required": [
        "reason"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "NOT_FOUND",
            "VALIDATION_FAILED",
            "ALLOCATION_CONFLICT",
            "ALLOCATION_NOT_HELD",
            "RATE_LIMITED",
            "REQUEST_TIMEOUT",
            "SERVICE_UNAVAILABLE",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "httpStatus": {
          "type": "integer"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "minItems": 1,
          "description": "Which field or header is wrong and why. Present on a 422 VALIDATION_FAILED only; the 409 ALLOCATION_CONFLICT and 409 ALLOCATION_NOT_HELD of this route, and every other code, carry none. The one stable reason is IDEMPOTENCY_KEY_REUSED (field X-Idempotency-Key); every other reason is free text and never carries internal text. See x-detail-reasons.",
          "items": {
            "$ref": "#/$defs/Detail"
          }
        }
      },
      "required": [
        "code",
        "message",
        "httpStatus",
        "correlationId"
      ]
    },
    "BaseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "v1"
        },
        "correlation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "correlationId": {
              "type": "string",
              "minLength": 1
            },
            "causationId": {
              "type": "string",
              "minLength": 1
            },
            "sourceSystem": {
              "type": "string",
              "minLength": 1
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "correlationId"
          ]
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "schemaVersion",
        "correlation",
        "error"
      ]
    },
    "InvalidRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "INVALID_REQUEST"
                },
                "httpStatus": {
                  "const": 400
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "Unauthorized": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "UNAUTHORIZED"
                },
                "httpStatus": {
                  "const": 401
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "Forbidden": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "FORBIDDEN"
                },
                "httpStatus": {
                  "const": 403
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "NotFound": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "NOT_FOUND"
                },
                "httpStatus": {
                  "const": 404
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "RequestTimeout": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "REQUEST_TIMEOUT"
                },
                "httpStatus": {
                  "const": 408
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "AllocationConflict": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "ALLOCATION_CONFLICT"
                },
                "httpStatus": {
                  "const": 409
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "AllocationNotHeld": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "ALLOCATION_NOT_HELD"
                },
                "httpStatus": {
                  "const": 409
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "ValidationFailed": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "VALIDATION_FAILED"
                },
                "httpStatus": {
                  "const": 422
                }
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "RateLimited": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "RATE_LIMITED"
                },
                "httpStatus": {
                  "const": 429
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "InternalError": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "INTERNAL_ERROR"
                },
                "httpStatus": {
                  "const": 500
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    },
    "ServiceUnavailable": {
      "allOf": [
        {
          "$ref": "#/$defs/BaseEnvelope"
        },
        {
          "properties": {
            "error": {
              "properties": {
                "code": {
                  "const": "SERVICE_UNAVAILABLE"
                },
                "httpStatus": {
                  "const": 503
                },
                "details": false
              },
              "required": [
                "code",
                "httpStatus"
              ]
            }
          }
        }
      ]
    }
  }
}
